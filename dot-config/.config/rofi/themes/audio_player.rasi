@theme "main_theme"

window {
    width: 35%;
    height: 10%;
    location: center;
    anchor: center;
}

mainbox {
    children: [inputbar, listview];
}

entry {
    background-color:               @background;
    text-color:                     @background;
    placeholder-color:              @background;
    placeholder:                    "";
    expand:                         true;
    horizontal-align:               0;
    blink:                          false;
    padding:                        6px;
}

element {
    orientation: horizontal;
}

textbox-prompt-colon {
	expand: false;
	str: "ﱘ";
    border: 1px;
    border-radius: 8px;
    padding: 6px 10px 6px 10px;
	font: "Iosevka Nerd Font 10";
}

inputbar {
    children: [textbox-prompt-colon, prompt];
    spacing: 0;
    expand: false;
    position: center;
}

listview {
    padding: 8 0;
    background-color: @bg;
    columns: 6;
    lines: 1;
    cycle: true;
    dynamic: true;
    layout: vertical;
}

